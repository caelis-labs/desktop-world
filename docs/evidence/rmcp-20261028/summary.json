        "source": "const window_ref = 'window_37395846-96d3-4482-a479-7f492e329a3a';\nconst before = await app.observe({window_ref});\nconst buttons = before.elements.filter(e => e.role === 'button' && e.name === 'Increment' && e.enabled === true && e.can_press && e.actions.includes('press'));\nconst counts = before.elements.filter(e => e.value === 'Count: 0');\nif (buttons.length !== 1 || counts.length !== 1) throw new Error('Expected unique enabled Increment and Count: 0');\nconst receipt = await app.press({window_ref, observation_ref: before.observation_ref, element_ref: buttons[0].element_ref});\nif (receipt.outcome.dispatch !== 'dispatched' || receipt.outcome.error || receipt.interruption) throw new Error('Press did not complete successfully: ' + JSON.stringify(receipt));\nconst after = await app.observe({window_ref});\nif (after.elements.filter(e => e.value === 'Count: 1').length !== 1) throw new Error('Expected Count: 1 after press');\nconst capture = await app.capture({window_ref});\nreturn {button: {role: buttons[0].role, name: buttons[0].name, enabled: buttons[0].enabled, actions: buttons[0].actions}, before_count: 0, after_count: 1, capture: capture.image};",
